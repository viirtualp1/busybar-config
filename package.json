{
  "name": "busybar-config",
  "version": "1.1.0",
  "description": "An interactive editor for the settings of every BUSY Bar app in a profile",
  "author": "viirtualp1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viirtualp1/busybar-config.git"
  },
  "bugs": {
    "url": "https://github.com/viirtualp1/busybar-config/issues"
  },
  "homepage": "https://github.com/viirtualp1/busybar-config#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "busybar-config": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "busy-bar",
    "busybar",
    "cli",
    "config",
    "prompts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && busybar-fix-esm",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "busybar-kit": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
